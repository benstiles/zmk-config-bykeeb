#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUMBER 1
#define FUNCTION 2
#define CONTROL 3
#define GAME 4


/ {
    behaviors {
        bhm: balanced_homerow_mods {
           compatible = "zmk,behavior-hold-tap";
           label = "HOMEROW_MODS";
           #binding-cells = <2>;
           tapping-term-ms = <200>;    // <---[[moderate duration]]
           quick-tap-ms = <125>;
           global-quick-tap;
           flavor = "balanced";
           bindings = <&kp>, <&kp>;
       };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 10>;
            bindings = <&kp ESC>;
        };
        combo_lctrl1 {
            timeout-ms = <50>;
            key-positions = <1 11>;
            bindings = <&kp LCTRL>;
        };
        combo_lctrl2 {
            timeout-ms = <50>;
            key-positions = <11 21>;
            bindings = <&kp LCTRL>;
        };
        combo_lalt1 {
            timeout-ms = <50>;
            key-positions = <2 12>;
            bindings = <&kp LALT>;
        };
        combo_lalt2 {
            timeout-ms = <50>;
            key-positions = <12 22>;
            bindings = <&kp LALT>;
        };
        combo_lgui1 {
            timeout-ms = <50>;
            key-positions = <3 13>;
            bindings = <&kp LGUI>;
        };
        combo_lgui2 {
            timeout-ms = <50>;
            key-positions = <13 23>;
            bindings = <&kp LGUI>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <14 24>;
            bindings = <&kp TAB>;
        };
        combo_lbrc {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp LBRC>;
        };
        combo_rbrc {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp RBRC>;
        };
        combo_lpar {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LPAR>;
        };
        combo_rpar {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp RPAR>;
        };
        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <25 26>;
            bindings = <&kp LBKT>;
        };
        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp RBKT>;
        };
        combo_rgui1 {
            timeout-ms = <50>;
            key-positions = <6 16>;
            bindings = <&kp RGUI>;
        };
        combo_rgui2 {
            timeout-ms = <50>;
            key-positions = <16 26>;
            bindings = <&kp RGUI>;
        };
        combo_ralt1 {
            timeout-ms = <50>;
            key-positions = <7 17>;
            bindings = <&kp RALT>;
        };
        combo_ralt2 {
            timeout-ms = <50>;
            key-positions = <17 27>;
            bindings = <&kp RALT>;
        };
        combo_rctrl1 {
            timeout-ms = <50>;
            key-positions = <8 18>;
            bindings = <&kp RCTRL>;
        };
        combo_rctrl2 {
            timeout-ms = <50>;
            key-positions = <18 28>;
            bindings = <&kp RCTRL>;
        };
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <19 29>;
            bindings = <&kp BSPC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUMBER FUNCTION>;
            then-layer = <CONTROL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            bindings = <
     &kp Q         &kp W  &kp E  &kp R          &kp T    &kp Y  &kp U          &kp I     &kp O   &kp P            
     &kp A         &kp S  &kp D  &bhm LSHIFT F  &kp G    &kp H  &bhm RSHIFT J  &kp K     &kp L   &kp SEMI         
     &bhm LSHIFT Z &kp X  &kp C  &kp V          &kp B    &kp N  &kp M          &kp COMMA &kp DOT &bhm RSHIFT FSLH 
               &lt FUNCTION ENTER &lt NUMBER BSPC &kp SPACE   &kp SPACE &lt NUMBER DELETE &lt FUNCTION ENTER
            >;
        };

        number_layer {
            bindings = <
     &kp UNDER  &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY    &kp EXCL  &kp AT     &kp HASH   &kp GRAVE  &kp TILDE 
     &kp MINUS  &kp N4  &kp N5  &kp N6  &kp PLUS           &kp DLLR  &kp PRCNT  &kp CARET  &kp SQT    &kp DQT   
     &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL          &kp PIPE  &kp BSLH   &kp AMPS   &none      &none     
                              &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        function_layer {
            bindings = <
     &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp C_VOL_UP   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   
     &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_VOL_DN   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  
     &none      &none     &none     &none      &none          &kp F11 &kp F12 &none   &none   &none    
                                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        control_layer {
            bindings = <
     &bt BT_CLR   &trans       &trans       &trans       &trans         &trans  &trans  &trans  &kp C_AL_CALC &tog GAME 
     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans  &trans  &trans  &trans        &trans    
     &trans       &trans       &trans       &trans       &trans         &trans  &trans  &trans  &trans        &trans    
                                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        game_layer {
            bindings = <
     &kp TAB  &kp Q   &kp W   &kp E   &kp R     &tog GAME  &tog GAME  &tog GAME  &tog GAME  &tog GAME  
     &kp M    &kp A   &kp S   &kp D   &kp F     &tog GAME  &tog GAME  &tog GAME  &tog GAME  &tog GAME  
     &kp N1   &kp N2  &kp N3  &kp N7  &kp B     &tog GAME  &tog GAME  &tog GAME  &tog GAME  &tog GAME  
                   &kp LCTRL &kp LSHIFT &kp SPACE    &tog GAME  &tog GAME  &tog GAME
            >;
        };
    };
};



